APP_NAME=e-Surat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Identitas perusahaan untuk server ini. Satu environment produksi melayani
# tepat satu perusahaan; nilainya dicatat di deployment manifest, bukan branch.
COMPANY_KEY=
# Feature opsional, dipisah koma: email, telegram, webpush. Kosong = semua
# feature mati.
# Feature `email` mewajibkan MAIL_MAILER nyata (bukan log) dan MAIL_FROM_ADDRESS.
COMPANY_FEATURES=
COMPANY_RULESET=default

PASSKEYS_USER_HANDLE_SECRET=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Lampiran surat disimpan di disk default: volume host persisten
# (DATA_PATH/storage/app/private) atau object storage privat (s3).
# JANGAN memakai disk `public` lokal atau `storage:link`.
FILESYSTEM_DISK=local
# Produksi: backend persisten yang dipakai semua replica (database/redis).
QUEUE_CONNECTION=database

# Produksi: cache/session persisten bersama untuk seluruh replica.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram bot untuk notifikasi inbox surat/disposisi/nota dinas.
# Isi ketiganya lalu jalankan `php artisan telegram:webhook:set` pada environment
# dengan APP_URL HTTPS publik. Tanpa nilai ini, kanal Telegram nonaktif dan
# email tetap berjalan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web Push browser untuk riwayat pemberitahuan internal. Hanya dipakai bila
# COMPANY_FEATURES memuat webpush, ketiga nilai di bawah terisi, dan APP_URL
# HTTPS dengan hostname domain (bukan alamat IP). Buat sekali dengan
# `php artisan webpush:vapid` lalu simpan stabil: mengganti kunci membatalkan
# seluruh subscription browser. VAPID_SUBJECT berupa URL HTTPS atau mailto:.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
