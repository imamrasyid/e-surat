# Template konfigurasi SATU perusahaan untuk Docker + FrankenPHP.
# Salin ke .env di direktori project (sebelah compose.yml), lalu isi nilainya.
# File ini tidak memuat secret sungguhan; jangan commit .env yang sudah diisi.

# ---------------------------------------------------------------------------
# Compose (dibaca docker compose, juga diteruskan ke container)
# ---------------------------------------------------------------------------
COMPANY_KEY=company-a
# Feature opsional, dipisah koma: email, telegram, webpush. Kosong = semua
# feature mati.
# Feature `email` mewajibkan SMTP nyata (bukan log) dan MAIL_FROM_ADDRESS.
COMPANY_FEATURES=
COMPANY_RULESET=default

# Tag rilis immutable dan image hasil pipeline.
RELEASE=v1.4.0
ESURAT_IMAGE=ghcr.io/msbhdn/e-surat:v1.4.0

# Direktori persistent di host Ubuntu (bukan di dalam container).
DATA_PATH=/srv/esurat/data

# 127.0.0.1 bila memakai reverse proxy di host; 0.0.0.0 untuk akses IP:port langsung.
APP_BIND_IP=127.0.0.1
APP_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
APP_NAME=e-Surat
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://esurat.company-a.example.com

# Proksi tepercaya untuk header X-Forwarded-*. 127.0.0.1: proxy di host yang
# sama, 172.16.0.0/12: gateway bridge Docker yang ditempuh koneksi Caddy/Nginx
# di host -> port yang di-publish ke 127.0.0.1. Tanpa rentang bridge ini, IP
# klien di log audit menjadi 172.x.x.x semua dan skema https tidak terdeteksi.
# Kosongkan bila container melayani trafik langsung (IP:port tanpa proxy).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Satu database per perusahaan.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=esurat_company_a
DB_USERNAME=esurat
DB_PASSWORD=

# Cache/session/queue persisten; jangan filesystem container.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=esurat_company_a
CACHE_STORE=database
QUEUE_CONNECTION=database

# Lampiran privat disimpan di storage/app/private pada volume host.
# Jangan memakai disk `public` atau `php artisan storage:link`.
FILESYSTEM_DISK=local

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Default: email hanya ditulis ke log (tidak dikirim). Aktifkan feature `email`
# dan isi blok SMTP di bawah untuk pengiriman nyata.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@company-a.example.com
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.company-a.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Hanya diisi bila COMPANY_FEATURES memuat telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Hanya diisi bila COMPANY_FEATURES memuat webpush. APP_URL wajib
# https://<domain> (bukan IP). Buat kunci sekali dengan `php artisan webpush:vapid`
# dan simpan stabil; mengganti kunci membatalkan subscription browser.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opsional: object storage, hanya bila memilih mode S3 (bukan volume host).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
